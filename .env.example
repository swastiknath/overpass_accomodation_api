# ── Operating Mode & System Config ──────────────────────────────────────────
DEMO_MODE=true
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
REDISTRIBUTION_ALLOWED=true

# ── OpenRouter LLM Layer ───────────────────────────────────────────────────
# Key is server-side only and must never be exposed to frontend
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_NARRATOR=anthropic/claude-3.5-sonnet
OPENROUTER_MODEL_VERIFIER=openai/gpt-4o-mini
OPENROUTER_FALLBACK_MODELS=["google/gemini-2.0-flash-001","meta-llama/llama-3.3-70b-instruct"]
OPENROUTER_REFERER=https://indiatravelsafety.org
OPENROUTER_APP_TITLE="India Travel Safety Intelligence"
LLM_DAILY_BUDGET_USD=10.0
LLM_DAILY_TOKEN_LIMIT=500000

# ── Geocoding & Maps ───────────────────────────────────────────────────────
GEOCODE_PROVIDER=nominatim
NOMINATIM_USER_AGENT="IndiaTravelSafety/2.0 (safety-research@indiatravelsafety.org)"
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
MAPBOX_ACCESS_TOKEN=

# ── Hotel Providers ────────────────────────────────────────────────────────
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=45.0
GOOGLE_PLACES_API_KEY=
FOURSQUARE_API_KEY=
AMADEUS_API_KEY=
AMADEUS_API_SECRET=

# ── Real-time Hazard Data Sources ──────────────────────────────────────────
# GDACS and USGS require no auth.

# NASA FIRMS (Active Fire Detections) — free key from https://firms.modaps.eosdis.nasa.gov/api/map_key
FIRMS_MAP_KEY=

# ACLED (Armed Conflict Location & Event Data) — register at https://developer.acleddata.com/
ACLED_EMAIL=
ACLED_PASSWORD=
ACLED_API_URL=https://api.acleddata.com

# data.gov.in (National Crime Records Bureau district IPC statistics) — key from https://data.gov.in
DATAGOV_API_KEY=

# OpenWeatherMap (optional fallback for Open-Meteo)
WEATHER_BACKEND=open_meteo
OPENWEATHERMAP_API_KEY=

# Bhuvan / NRSC (ISRO) WMS & WFS layers
BHUVAN_USERNAME=
BHUVAN_PASSWORD=
BHUVAN_WMS_BASE_URL=
BHUVAN_WFS_BASE_URL=

# Administrative boundaries (optional local Survey-of-India shapefile)
ADMIN_BOUNDARY_PATH=
ADMIN_ID_COLUMN=district_id
ADMIN_NAME_COLUMN=district_name
